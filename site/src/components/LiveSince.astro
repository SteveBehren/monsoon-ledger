---
// A live clock counting the time since a dated promise. The date and the promise come from
// data/deadlines.yml. The server renders whole days, so the figure is right without the script.
import type { Deadline } from '../lib/data';
import { promiseAnchor } from '../lib/ontology';
import { href, pick, type Lang } from '../lib/i18n';

interface Props {
  deadline: Deadline;
  lang: Lang;
  /** The build date, so the first render is never ahead of the page. */
  now?: Date;
}

const { deadline, lang, now = new Date() } = Astro.props;
const since = new Date(`${deadline.date_said}T00:00:00+07:00`);
const days = Math.floor((now.getTime() - since.getTime()) / 86_400_000);
const words =
  lang === 'en'
    ? { lead: 'Time since', said: 'said', days: 'days', h: 'hours', m: 'min', s: 'sec', open: 'See the promise' }
    : { lead: 'Waktu sejak', said: 'menyampaikan', days: 'hari', h: 'jam', m: 'menit', s: 'detik', open: 'Lihat janjinya' };
const promise = pick(lang, deadline.promised_en, deadline.promised_id);
---
<div class="live-since panel" data-live-since={since.toISOString()}>
  <p class="live-lead">
    <span class="live-dot" aria-hidden="true"></span>
    {words.lead} <time datetime={deadline.date_said}>{deadline.date_said}</time>, {lang === 'en' ? `when ${deadline.who} ${words.said}` : `ketika ${deadline.who} ${words.said}`}{' '}<q>{promise}</q>
  </p>
  <p class="live-clock" aria-live="off">
    <span><b data-unit="d">{days}</b> {words.days}</span>
    <span><b data-unit="h">00</b> {words.h}</span>
    <span><b data-unit="m">00</b> {words.m}</span>
    <span><b data-unit="s">00</b> {words.s}</span>
  </p>
  <a class="section-link" href={`${href(lang, 'ledger/')}#${promiseAnchor(deadline)}`}>{words.open} <span class="arrow" aria-hidden="true">&rarr;</span></a>
</div>

<script>
  for (const root of document.querySelectorAll<HTMLElement>('[data-live-since]')) {
    const since = new Date(root.dataset.liveSince!).getTime();
    const unit = (u: string) => root.querySelector<HTMLElement>(`[data-unit="${u}"]`)!;
    const [d, h, m, s] = ['d', 'h', 'm', 's'].map(unit);
    const pad = (n: number) => String(n).padStart(2, '0');
    const update = () => {
      let left = Math.max(0, Math.floor((Date.now() - since) / 1000));
      const days = Math.floor(left / 86400);
      left -= days * 86400;
      d.textContent = String(days);
      h.textContent = pad(Math.floor(left / 3600));
      m.textContent = pad(Math.floor((left % 3600) / 60));
      const sec = pad(left % 60);
      if (s.textContent !== sec) {
        s.textContent = sec;
        s.classList.remove('tick');
        void s.offsetWidth;
        s.classList.add('tick');
      }
    };
    update();
    setInterval(update, 1000);
  }
</script>
