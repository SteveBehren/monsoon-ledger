---
// Switches between the parts of the Method section. Every part keeps "Method" active in the main nav.
import { href, type Lang } from '../lib/i18n';

interface Props {
  lang: Lang;
  current: 'research' | 'system' | 'standard';
}

const { lang, current } = Astro.props;
const tabs = [
  { key: 'research', path: 'method/', label: lang === 'en' ? 'Research protocol' : 'Protokol penelitian' },
  { key: 'system', path: 'method/system/', label: lang === 'en' ? 'Technical system' : 'Sistem teknis' },
  { key: 'standard', path: 'method/standard/', label: lang === 'en' ? 'Promise format' : 'Format janji' },
] as const;
---
<nav class="tabs" aria-label={lang === 'en' ? 'Method sections' : 'Bagian metode'}>
  {tabs.map((tab) => <a href={href(lang, tab.path)} aria-current={tab.key === current ? 'page' : undefined}>{tab.label}</a>)}
</nav>
