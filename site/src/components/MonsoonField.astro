---
// The home page weather map. The isobars and rain are decoration. The markers are data:
// one for each public deadline in data/deadlines.yml, coloured by outcome, older promises on
// the outer rings. Each marker links to its row on the Promise vs Reality page.
// The animation pauses off screen and in background tabs, and never runs under reduced motion.
import type { Deadline } from '../lib/data';
import { promiseAnchor } from '../lib/ontology';
import { FIELD, ringPath, ringPoint, markerSlot } from '../lib/field';
import { ui, href, pick, type Lang } from '../lib/i18n';

interface Props {
  deadlines: Deadline[];
  lang: Lang;
}

const { deadlines, lang } = Astro.props;
const t = ui[lang];
const { W, H, cx, cy } = FIELD;
const rings = Array.from({ length: FIELD.rings }, (_, i) => ({ k: i + 1, d: ringPath(i + 1, 0) }));
const markers = deadlines.map((d, i) => {
  const { k, a } = markerSlot(i, deadlines.length);
  const [x, y] = ringPoint(k, a, 0);
  return { d, k, a, x, y };
});
const caption =
  lang === 'en'
    ? 'Each marker is a public deadline for Indonesia’s AI rules. Older promises sit on the outer rings. Red was missed, amber is still open. Select one to open it.'
    : 'Setiap penanda adalah tenggat publik untuk aturan AI Indonesia. Janji yang lebih lama ada di lingkaran luar. Merah berarti terlewat, kuning masih terbuka. Pilih untuk membukanya.';
---
<figure class="field" data-field>
  <svg class="isobars field-svg" viewBox={`0 0 ${W} ${H}`} role="group" aria-label={lang === 'en' ? 'Promise weather map' : 'Peta cuaca janji'}>
    <path class="rain" data-rain d="" aria-hidden="true" />
    <g aria-hidden="true">
      {rings.map((r) => <path class={r.k === 4 ? 'iso iso--key' : 'iso'} data-k={r.k} d={r.d} />)}
    </g>
    <circle class="pin" data-pin cx={cx} cy={cy} r="4" aria-hidden="true" />
    <circle class="pin-wave" data-pin-wave cx={cx} cy={cy} r="4" aria-hidden="true" />
    {
      markers.map((m) => (
        <a
          class={`field-marker fm-${m.d.outcome_status}`}
          href={`${href(lang, 'ledger/')}#${promiseAnchor(m.d)}`}
          data-k={m.k}
          data-a={m.a}
          transform={`translate(${m.x.toFixed(1)} ${m.y.toFixed(1)})`}
          aria-label={`${m.d.date_said}, ${m.d.who}: ${pick(lang, m.d.promised_en, m.d.promised_id)}. ${t.outcome[m.d.outcome_status]}.`}
        >
          <circle class="fm-halo" r="11" />
          <circle class="fm-dot" r="4.5" />
          <title>{`${m.d.date_said} · ${pick(lang, m.d.promised_en, m.d.promised_id)} (${t.outcome[m.d.outcome_status]})`}</title>
        </a>
      ))
    }
  </svg>
  <div class="field-tip" data-field-tip hidden></div>
  <figcaption>{caption}</figcaption>
</figure>

<script>
  import { FIELD, ringPath, ringPoint } from '../lib/field';

  for (const root of document.querySelectorAll<HTMLElement>('[data-field]')) {
    const svg = root.querySelector<SVGSVGElement>('svg')!;
    const rainPath = root.querySelector<SVGPathElement>('[data-rain]')!;
    const rings = [...root.querySelectorAll<SVGPathElement>('path.iso')];
    const pin = root.querySelector<SVGCircleElement>('[data-pin]')!;
    const wave = root.querySelector<SVGCircleElement>('[data-pin-wave]')!;
    const markers = [...root.querySelectorAll<SVGAElement>('.field-marker')];
    const tip = root.querySelector<HTMLElement>('[data-field-tip]')!;
    const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
    const { W, H } = FIELD;

    // Pointer pulls the eye of the storm a little and pushes the rain around it.
    let px = FIELD.cx;
    let py = FIELD.cy;
    let tx = FIELD.cx;
    let ty = FIELD.cy;
    let pointerX = -999;
    let pointerY = -999;
    svg.addEventListener('pointermove', (ev) => {
      const box = svg.getBoundingClientRect();
      pointerX = ((ev.clientX - box.left) / box.width) * W;
      pointerY = ((ev.clientY - box.top) / box.height) * H;
      tx = FIELD.cx + (pointerX - FIELD.cx) * 0.12;
      ty = FIELD.cy + (pointerY - FIELD.cy) * 0.12;
    });
    svg.addEventListener('pointerleave', () => {
      pointerX = pointerY = -999;
      tx = FIELD.cx;
      ty = FIELD.cy;
    });

    // Hover and focus show the promise in a small card.
    const show = (m: SVGAElement) => {
      tip.textContent = m.querySelector('title')!.textContent;
      tip.className = `field-tip ${[...m.classList].find((c) => c.startsWith('fm-')) ?? ''}`;
      tip.hidden = false;
    };
    for (const m of markers) {
      m.addEventListener('pointerenter', () => show(m));
      m.addEventListener('focus', () => show(m));
      m.addEventListener('pointerleave', () => (tip.hidden = true));
      m.addEventListener('blur', () => (tip.hidden = true));
    }

    const drops = Array.from({ length: 120 }, (_, i) => ({
      x: (i * 97) % W,
      y: (i * 53) % H,
      s: 0.6 + ((i * 37) % 10) / 10,
    }));

    const drawRain = (dt: number) => {
      let d = '';
      for (const p of drops) {
        // Wind from the upper right, with a swirl around the eye.
        const dx = p.x - px;
        const dy = p.y - py;
        const dist = Math.max(30, Math.hypot(dx, dy));
        let vx = -0.9 * p.s - (dy / dist) * (900 / dist) * 0.05;
        let vy = 2.4 * p.s + (dx / dist) * (900 / dist) * 0.05;
        const ex = p.x - pointerX;
        const ey = p.y - pointerY;
        const e2 = ex * ex + ey * ey;
        if (e2 < 3600) {
          vx += (ex / Math.sqrt(e2 + 1)) * 2.2;
          vy += (ey / Math.sqrt(e2 + 1)) * 2.2;
        }
        p.x += vx * dt;
        p.y += vy * dt;
        if (p.y > H + 10) p.y -= H + 20;
        if (p.y < -10) p.y += H + 20;
        if (p.x < -10) p.x += W + 20;
        if (p.x > W + 10) p.x -= W + 20;
        // Keep the eye clear, as the static map did.
        if (Math.hypot(dx / 1.25, dy / 0.85) < 62) continue;
        d += `M${p.x.toFixed(1)} ${p.y.toFixed(1)}l${(vx * 3).toFixed(1)} ${(vy * 3).toFixed(1)}`;
      }
      rainPath.setAttribute('d', d);
    };

    let t = 0;
    let last = 0;
    let running = false;
    let visible = true;
    const frame = (now: number) => {
      if (!running) return;
      const dt = last ? Math.min(3, (now - last) / 16.7) : 1;
      last = now;
      t += dt / 60;
      px += (tx - px) * 0.05;
      py += (ty - py) * 0.05;
      rings.forEach((r, i) => r.setAttribute('d', ringPath(i + 1, t, px, py)));
      pin.setAttribute('cx', px.toFixed(1));
      pin.setAttribute('cy', py.toFixed(1));
      wave.setAttribute('cx', px.toFixed(1));
      wave.setAttribute('cy', py.toFixed(1));
      for (const m of markers) {
        const [x, y] = ringPoint(Number(m.dataset.k), Number(m.dataset.a), t, px, py);
        m.setAttribute('transform', `translate(${x.toFixed(1)} ${y.toFixed(1)})`);
      }
      drawRain(dt);
      requestAnimationFrame(frame);
    };
    const start = () => {
      if (running || reduce || !visible || document.hidden) return;
      running = true;
      last = 0;
      requestAnimationFrame(frame);
    };
    const stop = () => (running = false);

    if (reduce) {
      drawRain(0);
    } else {
      new IntersectionObserver(([e]) => {
        visible = e.isIntersecting;
        visible ? start() : stop();
      }).observe(svg);
      document.addEventListener('visibilitychange', () => (document.hidden ? stop() : start()));
      start();
    }
  }
</script>
