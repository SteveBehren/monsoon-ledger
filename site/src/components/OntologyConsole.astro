---
// The ontology console: one window with three layers over the same objects.
//   Semantic: every object in a fixed lane by kind, with its links drawn between lanes.
//   Kinetic: the dated events behind those objects on one time axis.
//   Dynamic: what needs attention as of the build day, computed from the data.
// All three share one inspector. Everything is rendered at build time, so the lanes, the event
// log and the signals read without JavaScript; the script only draws links and handles focus.
import { OBJECT_TYPES, RELATIONS, type OntologyNode, type OntologyLink, type ObjectType } from '../lib/ontology';
import { LANES, placeOf, sortKey, buildEvents, buildSignals, LENS_COUNT, type LaneKey, type ConsoleEvent } from '../lib/console';
import { speaker } from '../lib/data';
import { ui, href, fmtDate, MONTHS, type Lang } from '../lib/i18n';

interface Props {
  lang: Lang;
  nodes: OntologyNode[];
  links: OntologyLink[];
  basisNames: Record<'data' | 'curated' | 'machine', string>;
  propLabels: Record<string, string>;
  words: Record<string, string>;
  inspectorEmpty: string;
  matches: [string, string, string];
}
const { lang, nodes, links, basisNames, propLabels, words, inspectorEmpty, matches } = Astro.props;
const t = ui[lang];
const byId = new Map(nodes.map((n) => [n.id, n]));
const typeName = (ty: ObjectType) => OBJECT_TYPES[ty][lang];

const c = {
