    nothing: 'Tidak ada untuk hari ini.',
    cards: {
      overdue: ['Janji yang melewati tenggat', 'Janji bertanggal yang tenggatnya lewat tanpa hasil tercatat, atau hasilnya datang setelah tenggat.'],
      ahead: ['Tenggat yang masih di depan', 'Janji bertanggal yang masih bisa dipenuhi. Diurutkan menurut sisa hari.'],
      undated: ['Janji tanpa tenggat', 'Klaim bersyarat atau klaim kemajuan. Tidak pernah dihitung sebagai terlewat.'],
