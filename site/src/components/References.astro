---
// The numbered reference list for a page. Order follows `keys`, which also drives <Cite> numbering.
import { REFERENCES, type RefKey, type Reference } from '../lib/references';
import { ui, type Lang } from '../lib/i18n';

interface Props {
  keys: readonly RefKey[];
  title: string;
  lang?: Lang;
}

const { keys, title, lang = 'en' } = Astro.props;
const ref = (key: RefKey): Reference => REFERENCES[key];
---
<section class="refs" aria-labelledby="refs-h">
  <h2 id="refs-h">{title}</h2>
  <ol>
    {
      keys.map((key) => (
        <li id={`ref-${key}`}>
          {ref(key).text}{' '}
          <a href={ref(key).url}>{ref(key).url}</a>
          {ref(key).archive_url && <>{' '}(<a href={ref(key).archive_url}>{ui[lang].archived}</a>, {ref(key).archived_at})</>}
        </li>
      ))
    }
  </ol>
</section>
