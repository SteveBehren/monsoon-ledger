---
// A status badge. The tone picks the colour: red for missed or withdrawn,
// amber for anything still pending, green for met, signed, in force or binding.
interface Props {
  tone: string;
  label: string;
  title?: string;
}
const { tone, label, title } = Astro.props;
---
<span class={`stamp stamp--${tone}`} title={title}>{label}</span>
