---
import '../styles/global.css';
import '../styles/visual.css';
import '../styles/console.css';
import BrandMark from '../components/BrandMark.astro';
import SiteHead from '../components/SiteHead.astro';
import { ui, other, href, SITE, type Lang } from '../lib/i18n';

interface Props {
  lang: Lang;
  // Path after the language prefix, for example "ledger/" or "" for home.
  path: string;
  title?: string;
  description?: string;
  ogType?: 'website' | 'article';
  /** Path of a page-specific 1200 by 630 preview image. Defaults to the site card. */
  ogImage?: string;
  nav?: 'home' | 'entries' | 'ledger' | 'instruments' | 'analysis' | 'ontology' | 'radar' | 'method' | 'about';
  /** For example "noindex": kept reachable by its url, left out of search results. */
  robots?: string;
}

const { lang, path, title, description, ogType = 'website', ogImage, nav, robots } = Astro.props;
const t = ui[lang];
const alt = other(lang);
// Tabs show the page name first and the site name after it. Home shows the site name only.
const fullTitle = title ? `${title} | ${SITE.name}` : SITE.name;
const desc = description ?? t.tagline;
const canonical = new URL(href(lang, path), SITE.url).href;
const enUrl = new URL(href('en', path), SITE.url).href;
const idUrl = new URL(href('id', path), SITE.url).href;

// The brand links home, so Home is not repeated in the navigation.
// Research pages sit in the footer, not the main navigation.
const research = [
  { key: 'safety', path: 'safety/' },
  { key: 'incidents', path: 'incidents/' },
  { key: 'reading', path: 'reading/' },
  { key: 'corrections', path: 'corrections/' },
] as const;

const links = [
  { key: 'entries', path: 'entries/' },
  { key: 'ledger', path: 'ledger/' },
  { key: 'instruments', path: 'instruments/' },
  { key: 'analysis', path: 'analysis/' },
  { key: 'ontology', path: 'ontology/' },
  { key: 'radar', path: 'radar/' },
  { key: 'method', path: 'method/' },
  { key: 'about', path: 'about/' },
] as const;
---
<!doctype html>
<html lang={t.htmlLang} data-theme="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={desc} />
    <meta name="author" content={SITE.author} />
    {robots && <meta name="robots" content={robots} />}
    <meta name="color-scheme" content="dark light" />
    <meta name="theme-color" content="#0a0e13" />
    <script is:inline>
      // Dark by default. A saved choice wins. Runs before paint to avoid a flash.
      (function () {
        var d = document.documentElement;
        var theme = 'dark';
        try {
          if (localStorage.getItem('ml-theme') === 'light') theme = 'light';
        } catch (e) {}
        d.setAttribute('data-theme', theme);
        d.classList.add('js');
      })();
    </script>
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang="en" href={enUrl} />
    <link rel="alternate" hreflang="id" href={idUrl} />
    <link rel="alternate" hreflang="x-default" href={enUrl} />
    <link rel="alternate" type="application/rss+xml" title={`${SITE.name} (${t.langName})`} href={href(lang, 'feed.xml')} />
    <link rel="sitemap" href="/sitemap.xml" />
    <SiteHead
      lang={lang}
      title={title ?? SITE.name}
      description={desc}
      url={canonical}
      ogType={ogType}
      image={ogImage}
      locale={t.ogLocale}
      altLocale={ui[alt].ogLocale}
    />
    <slot name="head" />
  </head>
  <body>
    <a class="skip-link" href="#main">{t.skip}</a>
    <header class="masthead">
      <div class="wrap">
        <a class="brand" href={href(lang)}>
          <BrandMark />
          <span>{SITE.name}</span>
          <span class="brand-sub">{t.brandSub}</span>
        </a>

        <nav class="site-nav site-nav--wide" aria-label={t.navLabel}>
          <ul>
            {
              links.map((l) => (
                <li>
                  <a href={href(lang, l.path)} aria-current={nav === l.key ? 'page' : undefined}>
                    {t.nav[l.key]}
                  </a>
                </li>
              ))
            }
          </ul>
        </nav>

        <div class="tools">
          <nav class="lang-switch" aria-label={t.langSwitchLabel}>
            {
              (['en', 'id'] as const).map((l) =>
                l === lang ? (
                  <span aria-current="true" lang={ui[l].htmlLang} title={ui[l].langName}>
                    {ui[l].langShort}
                  </span>
                ) : (
                  <a href={href(l, path)} hreflang={l} lang={ui[l].htmlLang} title={ui[l].langName}>
                    {ui[l].langShort}
                    <span class="visually-hidden"> {ui[l].langName}</span>
                  </a>
                ),
              )
            }
          </nav>
          <button
            type="button"
            class="icon-btn theme-toggle"
            data-theme-toggle
            data-label-light={t.theme.toLight}
            data-label-dark={t.theme.toDark}
            aria-label={t.theme.toLight}
            title={t.theme.toLight}
          >
            <svg class="sun" viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round">
              <circle cx="12" cy="12" r="4" />
              <path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4" />
            </svg>
            <svg class="moon" viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linejoin="round">
              <path d="M20 14.5A8 8 0 1 1 9.5 4a6.5 6.5 0 0 0 10.5 10.5z" />
            </svg>
          </button>
          <details class="menu">
            <summary class="icon-btn" aria-label={t.menu} title={t.menu}>
              <svg viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round">
                <path d="M4 7h16M4 12h16M4 17h16" />
              </svg>
            </summary>
            <nav class="menu-panel" aria-label={t.navLabel}>
              <ul>
                {
                  links.map((l) => (
                    <li>
                      <a href={href(lang, l.path)} aria-current={nav === l.key ? 'page' : undefined}>
                        {t.nav[l.key]}
                      </a>
                    </li>
                  ))
                }
              </ul>
            </nav>
          </details>
        </div>
      </div>
    </header>

    <main id="main" tabindex="-1">
      <div class="wrap">
        <slot />
      </div>
    </main>

    <footer class="site-footer">
      <div class="wrap">
        <div class="footer-grid">
          <div>
            <p class="footer-brand"><BrandMark />{SITE.name}</p>
            <p lang={t.htmlLang}>{t.tagline}</p>
          </div>
          <div>
            <h2>{t.footerExplore}</h2>
            <ul>
              {links.map((l) => <li><a href={href(lang, l.path)}>{t.nav[l.key]}</a></li>)}
            </ul>
          </div>
          <div>
            <h2>{t.footerResearch}</h2>
            <ul>
              {research.map((l) => <li><a href={href(lang, l.path)}>{t.footerPages[l.key]}</a></li>)}
            </ul>
          </div>
          <div>
            <h2>{t.footerProject}</h2>
            <ul>
              <li><a href={SITE.repo}>{t.footerRepo}</a></li>
              <li><a href={SITE.changelog}>{t.footerChangelog}</a></li>
              <li><a href={SITE.issues}>{t.openIssue}</a></li>
              <li><a href={href(lang, 'feed.xml')}>{t.feed}</a></li>
            </ul>
          </div>
        </div>
        <p class="footer-legal">{t.footerLicence}</p>
      </div>
    </footer>

    <script>
      const toggle = document.querySelector<HTMLButtonElement>('[data-theme-toggle]');
      const root = document.documentElement;
      const label = () => {
        if (!toggle) return;
        const next = root.dataset.theme === 'dark' ? toggle.dataset.labelLight! : toggle.dataset.labelDark!;
        toggle.setAttribute('aria-label', next);
        toggle.title = next;
      };
      label();
      toggle?.addEventListener('click', () => {
        const theme = root.dataset.theme === 'dark' ? 'light' : 'dark';
        root.dataset.theme = theme;
        try {
          localStorage.setItem('ml-theme', theme);
        } catch {}
        label();
      });

      // Close the mobile menu after following a link or pressing Escape.
      const menu = document.querySelector<HTMLDetailsElement>('.menu');
      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape' && menu?.open) {
          menu.open = false;
          menu.querySelector('summary')?.focus();
        }
      });

      // Fade sections in once as they scroll into view.
      const items = document.querySelectorAll('[data-reveal]');
      if ('IntersectionObserver' in window) {
        const io = new IntersectionObserver(
          (entries) => {
            for (const e of entries) {
              if (e.isIntersecting) {
                e.target.classList.add('is-in');
                io.unobserve(e.target);
              }
            }
          },
          { rootMargin: '0px 0px -8% 0px' },
        );
        items.forEach((el) => io.observe(el));
      } else {
        items.forEach((el) => el.classList.add('is-in'));
      }

      // Day counts on receipts are built as of the build day (WIB) and brought up to today here.
      // If an open deadline has passed since the build, the page keeps its build-day values, which
      // agree with each other, until the next build recomputes the outcome.
      {
        const now = new Date();
        const today = new Intl.DateTimeFormat('en-CA', { timeZone: 'Asia/Jakarta' }).format(now);
        const days = (d: string) => Math.round((Date.parse(`${today}T00:00:00Z`) - Date.parse(`${d}T00:00:00Z`)) / 86_400_000);
        const past = [...document.querySelectorAll<HTMLElement>('[data-days-past]')];
        const left = [...document.querySelectorAll<HTMLElement>('[data-days-left]')];
        if (left.every((el) => days(el.dataset.daysLeft!) <= 0)) {
          for (const el of past) el.textContent = String(Math.max(1, days(el.dataset.daysPast!)));
          for (const el of left) el.textContent = String(-days(el.dataset.daysLeft!));
          const fmt = new Intl.DateTimeFormat(root.lang === 'id' ? 'id-ID' : 'en-GB', { day: 'numeric', month: 'long', year: 'numeric', timeZone: 'Asia/Jakarta' });
          for (const el of document.querySelectorAll<HTMLTimeElement>('time[data-today]')) {
            el.dateTime = today;
            el.textContent = fmt.format(now);
          }
        }
      }

      // Whole numbers in metric tiles count up the first time they come into view.
      const still = matchMedia('(prefers-reduced-motion: reduce)').matches;
      const figures = [...document.querySelectorAll<HTMLElement>('.metric .figure, .balance-legend .figure')].filter((el) =>
        /^\d+$/.test(el.firstChild?.textContent?.trim() ?? ''),
      );
      if (!still && 'IntersectionObserver' in window) {
        const counter = new IntersectionObserver((entries) => {
          for (const e of entries) {
            if (!e.isIntersecting) continue;
            counter.unobserve(e.target);
            const node = e.target.firstChild!;
            const target = Number(node.textContent!.trim());
            const t0 = performance.now();
            const step = (now: number) => {
              const p = Math.min(1, (now - t0) / 900);
              node.textContent = String(Math.round(target * (1 - Math.pow(1 - p, 3))));
              if (p < 1) requestAnimationFrame(step);
            };
            requestAnimationFrame(step);
          }
        });
        figures.forEach((el) => counter.observe(el));
      }
    </script>
  </body>
</html>
