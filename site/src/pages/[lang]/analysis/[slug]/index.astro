---
// One analysis paper. The English text is complete. The Bahasa Indonesia text may be a partial
// draft translation (partial: true), in which case each section carries the draft note and links
// to the English section, and the reference list shows only the sources that text cites.
// Figures and the promise table are computed from data/deadlines.yml on the paper's facts day.
import Base from '../../../../layouts/Base.astro';
import '../../../../styles/analysis.css';
import CiteBox from '../../../../components/CiteBox.astro';
import PaperReferences from '../../../../components/PaperReferences.astro';
import PromiseDaysFigure from '../../../../components/PromiseDaysFigure.astro';
import PromiseTable from '../../../../components/PromiseTable.astro';
import { getPaperIds, getPaper, hasPaper, changesTagged, fileSize } from '../../../../lib/analysis';
import { ui, href, fmtDate, other, SITE, LANGS, type Lang } from '../../../../lib/i18n';

export function getStaticPaths() {
  return getPaperIds().flatMap((slug) => LANGS.filter((lang) => hasPaper(slug, lang)).map((lang) => ({ params: { lang, slug } })));
}

const lang = Astro.params.lang as Lang;
const slug = Astro.params.slug!;
const t = ui[lang];
const enHref = href('en', `analysis/${slug}/`);
const paper = getPaper(slug, lang, enHref);
const { meta } = paper;
const en = lang === 'en' ? paper : getPaper(slug, 'en');
const number = String(meta.number).padStart(2, '0');
const url = new URL(href(lang, `analysis/${slug}/`), SITE.url).href;
const docxUrl = meta.docx ? new URL(`/${meta.docx}`, SITE.url).href : null;
const tag = `analysis-${number}`;
const changes = changesTagged(tag);
const modified = changes.reduce((max, c) => (c.date > max ? c.date : max), String(meta.published));
const altLang = other(lang);
const altHref = hasPaper(slug, altLang) ? href(altLang, `analysis/${slug}/`) : null;
const sources = lang === 'en' ? paper.sources : paper.sources.filter((s) => paper.citeCounts.has(s.n));

const copy =
  lang === 'en'
    ? {
        kicker: `Analysis ${number}`,
        by: 'By',
        published: 'Published',
        version: `Version ${meta.version}`,
        read: `${paper.minutes} minute read`,
        factsAsOf: `Facts as of ${fmtDate(lang, String(meta.facts_as_of))}`,
        factsNote:
          'Every fact in this paper was checked as of this day. The figure and Table A1 compute each promise as of the same day. The live ledger shows them as of today.',
        ledger: 'Open the live ledger',
        docx: 'Download the paper (Word document',
        toc: 'Contents',
        changes: 'Changes to this paper',
        noChanges: 'No changes since publication.',
        corrections: 'Corrections and review',
        correctionsText: 'Found an error? Corrections are logged with their date.',
        correctionLink: 'Report a correction',
        allCorrections: 'All corrections',
        brief: 'Two-page brief',
        alt: 'Baca dalam bahasa Indonesia (terjemahan sebagian)',
        partial: '',
        reportType: 'Monsoon Ledger Analysis',
      }
    : {
        kicker: `Analisis ${number}`,
        by: 'Oleh',
        published: 'Terbit',
        version: `Versi ${meta.version}`,
        read: `${paper.minutes} menit membaca`,
        factsAsOf: `Fakta per ${fmtDate(lang, String(meta.facts_as_of))}`,
        factsNote:
          'Setiap fakta dalam makalah ini diperiksa per hari itu. Gambar dan tabel janji menghitung setiap janji per hari yang sama. Catatan janji yang aktif menampilkannya per hari ini.',
        ledger: 'Buka catatan janji',
        docx: 'Unduh makalah lengkap dalam bahasa Inggris (dokumen Word',
        toc: 'Daftar isi',
        changes: 'Perubahan pada makalah ini',
        noChanges: 'Belum ada perubahan sejak terbit.',
        corrections: 'Koreksi dan tinjauan',
        correctionsText: 'Menemukan kesalahan? Setiap koreksi dicatat beserta tanggalnya.',
        correctionLink: 'Laporkan koreksi',
        allCorrections: 'Semua koreksi',
        brief: 'Ringkasan dua halaman',
        alt: 'Baca teks lengkap dalam bahasa Inggris',
        partial:
          'Halaman ini memuat terjemahan draf dari judul, temuan utama, ringkasan eksekutif, batas argumen, dan rekomendasi. Terjemahan ini masih menunggu tinjauan penulis. Teks lengkapnya dalam bahasa Inggris.',
        reportType: 'Analisis Monsoon Ledger',
      };

// Citation formats. The author name matches the About page.
const [py, pm, pd] = String(meta.published).split('-').map(Number);
const apaDate = `${py}, ${['January', 'February', 'March', 'April', 'May', 'June', 'July', 'August', 'September', 'October', 'November', 'December'][pm - 1]} ${pd}`;
const citePlain = `${SITE.author} (${py}). ${meta.title}: ${meta.subtitle} ${copy.reportType} ${number}, ${copy.version}. ${SITE.name}. ${url}`;
const citeApa = `Tanjung, S. B. (${apaDate}). ${meta.title}: ${meta.subtitle} (${copy.reportType} No. ${number}, ${copy.version}). ${SITE.name}. ${url}`;
const tex = (s: string) => s.replace(/([&%$#_{}])/g, '\\$1');
const citeBib = `@techreport{tanjung${py}${slug.replace(/[^a-z]/g, '')},
  author      = {Tanjung, Stephen Behren},
  title       = {{${tex(meta.title)}}: ${tex(meta.subtitle)}},
  institution = {${SITE.name}},
  type        = {${copy.reportType}},
  number      = {${number}},
  year        = {${py}},
  month       = {${['jan', 'feb', 'mar', 'apr', 'may', 'jun', 'jul', 'aug', 'sep', 'oct', 'nov', 'dec'][pm - 1]}},
  note        = {${copy.version}. ${tex(copy.factsAsOf)}},
  url         = {${url}}
}`;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'ScholarlyArticle',
  headline: meta.title,
  alternativeHeadline: meta.subtitle,
  description: meta.summary,
  author: { '@type': 'Person', name: SITE.author, url: new URL(href(lang, 'about/'), SITE.url).href },
  publisher: { '@type': 'Organization', name: SITE.name, url: SITE.url },
  datePublished: String(meta.published),
  dateModified: modified,
  inLanguage: lang,
  version: String(meta.version),
  license: 'https://creativecommons.org/licenses/by/4.0/',
  isAccessibleForFree: true,
  url,
  mainEntityOfPage: url,
  about: ['AI governance', 'AI incident reporting', 'Frontier AI', 'Indonesia', 'Personal data protection'],
  ...(lang === 'id' ? { translationOfWork: { '@type': 'ScholarlyArticle', url: new URL(enHref, SITE.url).href } } : {}),
  citation: en.sources.map((s) => ({ '@type': 'CreativeWork', name: s.title, url: s.url })),
};
const issueUrl = `${SITE.issues}/new?template=correction.yml&title=${encodeURIComponent(`Correction: Analysis ${number}`)}`;
---
<Base lang={lang} path={`analysis/${slug}/`} title={meta.title} description={meta.summary} ogType="article" ogImage={`/og/${lang}/analysis-${slug}.png`} nav="analysis">
  <Fragment slot="head">
    <meta name="citation_title" content={`${meta.title}: ${meta.subtitle}`} />
    <meta name="citation_author" content="Tanjung, Stephen Behren" />
    <meta name="citation_publication_date" content={String(meta.published).replace(/-/g, '/')} />
    <meta name="citation_online_date" content={String(meta.published).replace(/-/g, '/')} />
    <meta name="citation_technical_report_institution" content={SITE.name} />
    <meta name="citation_technical_report_number" content={`Analysis ${number}`} />
    <meta name="citation_language" content={lang} />
    <meta name="citation_abstract_html_url" content={url} />
    {docxUrl && <meta name="citation_pdf_url" content={docxUrl} />}
    <meta property="article:published_time" content={String(meta.published)} />
    <meta property="article:modified_time" content={modified} />
    <meta property="article:author" content={SITE.author} />
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </Fragment>

  <article class="paper" lang={t.htmlLang}>
    <header class="page-head paper-head">
      <p class="kicker"><a href={href(lang, 'analysis/')}>{copy.kicker}</a></p>
      <h1>{meta.title}</h1>
      <p class="lede">{meta.subtitle}</p>
      <p class="paper-byline">
        {copy.by} <a href={href(lang, 'about/')}>{SITE.author}</a> · {copy.published} <time datetime={String(meta.published)}>{fmtDate(lang, String(meta.published))}</time> · {copy.version} · {copy.read}
      </p>
      {copy.partial && <p class="draft-note draft-note--page">{copy.partial} <a href={enHref} hreflang="en">{copy.alt}</a>.</p>}
      <div class="paper-actions">
        {
          docxUrl && paper.docxBytes && (
            <a class="btn btn--primary" href={`/${meta.docx}`} download hreflang="en">
              {copy.docx}, {fileSize(paper.docxBytes)})
            </a>
          )
        }
        {lang === 'en' && altHref && <a class="btn" href={altHref} hreflang="id" lang="id">{copy.alt}</a>}
        {hasPaper(slug, 'en') && <a class="btn" href={href(lang, `analysis/${slug}/brief/`)}>{copy.brief}</a>}
      </div>
    </header>

    <div class="paper-grid">
      <aside class="paper-side">
        <nav class="paper-toc paper-toc--wide" aria-label={copy.toc}>
          <p class="label">{copy.toc}</p>
          <ol>
            {paper.toc.filter((i) => i.level === 2).map((i) => <li><a href={`#${i.id}`}>{i.text}</a></li>)}
            <li><a href="#refs-h">{lang === 'en' ? 'References' : 'Daftar pustaka'}</a></li>
          </ol>
        </nav>
        <section class="facts-box panel" aria-labelledby="facts-h">
          <h2 id="facts-h" class="label">{copy.factsAsOf}</h2>
          <p>{copy.factsNote}</p>
          <p><a href={href(lang, 'ledger/')}>{copy.ledger}</a></p>
        </section>
      </aside>

      <div class="paper-body doc-body">
        <details class="paper-toc paper-toc--narrow">
          <summary>{copy.toc}</summary>
          <ol>
            {paper.toc.filter((i) => i.level === 2).map((i) => <li><a href={`#${i.id}`}>{i.text}</a></li>)}
            <li><a href="#refs-h">{lang === 'en' ? 'References' : 'Daftar pustaka'}</a></li>
          </ol>
        </details>

        {
          paper.segments.map((s) =>
            s.kind === 'html' ? (
              <Fragment set:html={s.html} />
            ) : s.kind === 'figure' && s.name === 'promise-days' ? (
              <PromiseDaysFigure lang={lang} asOf={String(meta.facts_as_of)} rows={paper.promises.length ? paper.promises : en.promises} caption={s.caption} />
            ) : s.kind === 'table' && s.name === 'promises' ? (
              <PromiseTable lang={lang} asOf={String(meta.facts_as_of)} rows={paper.promises} caption={s.caption} captionId={s.captionId} />
            ) : null,
          )
        }

        <section class="paper-changes" aria-labelledby="changes-h">
          <h2 id="changes-h">{copy.changes}</h2>
          <p class="paper-version">{copy.version} · {copy.factsAsOf}</p>
          {
            changes.length ? (
              <ul>
                {changes.map((c) => (
                  <li>
                    <time datetime={c.date}>{fmtDate(lang, c.date)}</time>: <span lang="en">{c.text}</span>
                  </li>
                ))}
              </ul>
            ) : (
              <p>{copy.noChanges}</p>
            )
          }
          <h3>{copy.corrections}</h3>
          <p>
            {copy.correctionsText} <a href={issueUrl}>{copy.correctionLink}</a> · <a href={href(lang, 'corrections/')}>{copy.allCorrections}</a>
          </p>
        </section>

        <CiteBox lang={lang} plain={citePlain} apa={citeApa} bibtex={citeBib} id="paper-cite-h" />

        <PaperReferences lang={lang} sources={sources} counts={paper.citeCounts} />
      </div>
    </div>
  </article>
</Base>
