---
import Base from '../../../layouts/Base.astro';
import EntryItem from '../../../components/EntryItem.astro';
import { getEntries, STATUSES, TOPICS } from '../../../lib/data';
import { ui, LANGS, type Lang } from '../../../lib/i18n';

export function getStaticPaths() {
  return LANGS.map((lang) => ({ params: { lang } }));
}

const lang = Astro.params.lang as Lang;
const t = ui[lang];
const entries = getEntries();

const copy = {
  en: {
    intro: 'Newest first. Each entry records one instrument, statement or decision, with its status, the strength of the evidence and the date its sources were last checked.',
    all: 'All',
    topicLabel: 'Safety topic',
    topicHint: 'The topic filter shows entries where the answer is yes, or where enforcement is binding or soft.',
    shown: 'entries shown',
    none: 'No entries match these filters.',
  },
  id: {
    intro: 'Terbaru di atas. Setiap catatan merekam satu instrumen, pernyataan, atau keputusan, lengkap dengan statusnya, kekuatan buktinya, dan tanggal terakhir sumbernya dicek.',
    all: 'Semua',
    topicLabel: 'Topik keselamatan',
    topicHint: 'Filter topik menampilkan catatan yang jawabannya ya, atau yang penegakannya mengikat atau lunak.',
    shown: 'catatan ditampilkan',
    none: 'Tidak ada catatan yang cocok dengan filter ini.',
  },
}[lang];
---
<Base lang={lang} path="entries/" title={t.nav.entries} nav="entries">
  <div class="prose">
    <h1>{t.nav.entries}</h1>
    <p>{copy.intro}</p>
  </div>

  <form class="filters" id="filters" hidden aria-describedby="topic-hint">
    <div>
      <label for="f-status">{t.statusLabel}</label>
      <select id="f-status" name="status">
        <option value="">{copy.all}</option>
        {STATUSES.map((s) => <option value={s}>{t.status[s]}</option>)}
      </select>
    </div>
    <div>
      <label for="f-topic">{copy.topicLabel}</label>
      <select id="f-topic" name="topic">
        <option value="">{copy.all}</option>
        {TOPICS.map((s) => <option value={s}>{t.topic[s]}</option>)}
      </select>
    </div>
    <p id="topic-hint" class="label-note">{copy.topicHint}</p>
  </form>
  <p class="filter-count" id="filter-count" aria-live="polite">{entries.length} {copy.shown}</p>

  <ol class="entry-list" id="entry-list">
    {entries.map((entry) => <EntryItem entry={entry} lang={lang} level={2} />)}
  </ol>
  <p id="no-match" hidden>{copy.none}</p>

  <script is:inline define:vars={{ shownLabel: copy.shown }}>
    (function () {
      var form = document.getElementById('filters');
      var status = document.getElementById('f-status');
      var topic = document.getElementById('f-topic');
      var items = document.querySelectorAll('#entry-list > li');
      var count = document.getElementById('filter-count');
      var none = document.getElementById('no-match');
      var params = new URLSearchParams(location.search);
      if (params.get('status')) status.value = params.get('status');
      if (params.get('topic')) topic.value = params.get('topic');
      form.hidden = false;

      function apply() {
        var shown = 0;
        items.forEach(function (li) {
          var ok =
            (!status.value || li.dataset.status === status.value) &&
            (!topic.value || (' ' + li.dataset.topics + ' ').indexOf(' ' + topic.value + ' ') !== -1);
          li.hidden = !ok;
          if (ok) shown++;
        });
        count.textContent = shown + ' ' + shownLabel;
        none.hidden = shown !== 0;
        var q = new URLSearchParams();
        if (status.value) q.set('status', status.value);
        if (topic.value) q.set('topic', topic.value);
        var qs = q.toString();
        history.replaceState(null, '', location.pathname + (qs ? '?' + qs : ''));
      }

      form.addEventListener('change', apply);
      form.addEventListener('submit', function (e) {
        e.preventDefault();
      });
      apply();
    })();
  </script>
</Base>
