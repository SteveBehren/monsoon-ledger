---
import Base from '../../layouts/Base.astro';
import Stamp from '../../components/Stamp.astro';
import PromiseReplay from '../../components/PromiseReplay.astro';
import ReceiptHeadline from '../../components/ReceiptHeadline.astro';
import PromiseBalance from '../../components/PromiseBalance.astro';
import { getDeadlines, getPromises, getEntries, outcomeCounts, OUTCOMES, type Outcome } from '../../lib/data';
import { ui, pick, href, fmtDate, SITE, LANGS, type Lang } from '../../lib/i18n';
import { promiseAnchor } from '../../lib/ontology';

export function getStaticPaths() {
  return LANGS.map((lang) => ({ params: { lang } }));
}

const lang = Astro.params.lang as Lang;
const t = ui[lang];
const deadlines = getDeadlines();
const promises = getPromises();
const counts = outcomeCounts(deadlines);
// Filter chips: the three outcomes of dated promises, then the claims that have no deadline.
const chips = ([...OUTCOMES, 'no-deadline'] as Outcome[])
  .map((o) => ({ o, n: promises.filter((p) => p.outcome === o).length }))
  .filter((c) => c.n > 0);
const related = getEntries().find((e) => e.id === '2026-10-21-id-perpres-ai-keep-almost-arriving');

const copy = {
  en: {
    title: 'Promise vs Reality',
    intro:
      "The public promises officials have made about Indonesia's AI rules, set against what happened next. Janji is the promise. Kenyataan is the reality. Each promise has a receipt with its deadline, its source and a preserved copy.",
    howTo:
      'Outcomes are computed, not set by hand: a dated promise turns from open to missed the day after its deadline, counted in Western Indonesian Time. Conditional promises and status claims set no deadline and are never counted as missed. When something happens, the row is updated and the change is logged in the changelog.',
    promise: 'Promise',
    reality: 'Reality',
    due: 'Deadline',
    entries: 'Read the entry on why the rules keep almost arriving',
  },
  id: {
    title: 'Janji vs Kenyataan',
    intro:
      'Janji publik pejabat tentang aturan AI Indonesia, disandingkan dengan apa yang terjadi sesudahnya. Janji adalah apa yang diucapkan. Kenyataan adalah apa yang terjadi. Setiap janji punya bukti janji lengkap dengan tenggat, sumber, dan salinan arsipnya.',
    howTo:
      'Hasilnya dihitung, tidak diisi manual: janji bertenggat berubah dari masih terbuka menjadi terlewat sehari setelah tenggatnya, dihitung menurut WIB. Janji bersyarat dan klaim kemajuan tidak menetapkan tenggat dan tidak pernah dihitung terlewat. Kalau sesuatu terjadi, baris diperbarui dan perubahannya dicatat di catatan perubahan.',
    promise: 'Janji',
    reality: 'Kenyataan',
    due: 'Tenggat',
    entries: 'Baca catatan tentang aturan yang tak kunjung terbit',
  },
}[lang];
---
<Base lang={lang} path="ledger/" title={copy.title} description={copy.intro} nav="ledger">
  <header class="page-head">
    <p class="kicker">{lang === 'en' ? t.ledgerOriginal : 'Tenggat yang dijanjikan pejabat'}</p>
    <h1>{copy.title}</h1>
    <p class="lede">{copy.intro}</p>
  </header>

  <div class="ledger-top" data-reveal>
    <PromiseBalance counts={counts} lang={lang} panel />
    <ReceiptHeadline lang={lang} />
  </div>

  <div class="section section--tight">
    <PromiseReplay deadlines={deadlines} lang={lang} />
  </div>

  <div class="section section--tight">
    <form class="filters panel" id="outcome-filter" hidden>
      <fieldset class="chips">
        <legend>{t.show}</legend>
        <label class="chip"><input type="radio" name="outcome" value="" checked /><span>{t.all} <span class="count">{deadlines.length}</span></span></label>
        {
          chips.map(({ o, n }) => (
            <label class="chip">
              <input type="radio" name="outcome" value={o} />
              <span>
                {t.outcome[o]} <span class="count">{n}</span>
              </span>
            </label>
          ))
        }
      </fieldset>
    </form>
    <p class="filter-hint">{copy.howTo}</p>

    <ol class="timeline" id="timeline">
      {
        promises.map((d) => (
          <li data-outcome={d.outcome} id={promiseAnchor(d)}>
            <time class="t-date" datetime={d.date_said}>{d.date_said}</time>
            <span class="t-dot" aria-hidden="true" />
            <div class="t-card panel">
              <div class="t-col">
                <p class="label">
                  {copy.promise}
                  {lang === 'en' && <span lang="id">Janji</span>}
                </p>
                <a class="t-text t-receipt" href={href(lang, `promises/${d.key}/`)}>{pick(lang, d.promised_en, d.promised_id)}</a>
                <span class="t-who">
                  <span>{d.who}</span>
                  <a href={d.source_url}>
                    {t.source} <span aria-hidden="true">&#8599;</span>
                  </a>
                  {d.archive_url && <a href={d.archive_url}>{t.archived}</a>}
                </span>
              </div>
              <div class="t-col">
                <p class="label">
                  {copy.reality}
                  {lang === 'en' && <span lang="id">Kenyataan</span>}
                </p>
                <span class="t-text">{pick(lang, d.outcome_en, d.outcome_id)}</span>
                <span class="t-due">
                  <Stamp tone={d.outcome} label={t.outcome[d.outcome]} />
                  {d.deadline && <span>{copy.due} {fmtDate(lang, d.deadline)}</span>}
                </span>
              </div>
            </div>
          </li>
        ))
      }
    </ol>
  </div>

  <div class="correction">
    <p>{related && <a href={href(lang, `entries/${related.id}/`)}>{copy.entries} <span class="arrow" aria-hidden="true">&rarr;</span></a>}</p>
    <p>
      {t.corrections} <a href={SITE.issues}>{t.openIssue}</a>
    </p>
  </div>

  <script>
    const form = document.getElementById('outcome-filter') as HTMLFormElement;
    const rows = document.querySelectorAll<HTMLElement>('#timeline > li');
    form.hidden = false;
    form.addEventListener('change', () => {
      const v = (form.querySelector('input:checked') as HTMLInputElement).value;
      rows.forEach((li) => (li.hidden = v !== '' && li.dataset.outcome !== v));
    });
    form.addEventListener('submit', (e) => e.preventDefault());
  </script>
</Base>
