---
import fs from 'node:fs';
import path from 'node:path';
import yaml from 'js-yaml';
import Base from '../../../layouts/Base.astro';
import MethodTabs from '../../../components/MethodTabs.astro';
import PageRail from '../../../components/PageRail.astro';
import NextScan from '../../../components/NextScan.astro';
import { getWatchSources, getScanLog, getBuildLog, BUILD_KINDS } from '../../../lib/data';
import { ui, href, SITE, LANGS, type Lang } from '../../../lib/i18n';

export function getStaticPaths() {
  return LANGS.map((lang) => ({ params: { lang } }));
}

const lang = Astro.params.lang as Lang;
const t = ui[lang];
const sources = getWatchSources();
const log = getScanLog();
const keywords = yaml.load(fs.readFileSync(path.resolve(process.cwd(), '..', 'data', 'watch', 'keywords.yml'), 'utf8'), { schema: yaml.CORE_SCHEMA }) as {
  threshold: number;
  terms: unknown[];
  exclude: unknown[];
};
const newsSources = sources.filter((s) => s.kind === 'news-search').length;
const pageSources = sources.filter((s) => s.kind !== 'news-search').length;
const countries = [...new Set(sources.map((s) => s.country))].join(', ');
const cols = lang === 'en' ? ['Layer', 'Choice', 'Why'] : ['Lapisan', 'Pilihan', 'Alasan'];
const commit = (hash: string) => `${SITE.repo}/commit/${hash}`;
const file = (p: string) => `${SITE.repo}/blob/main/${p}`;

const toc = {
  en: [
    ['overview', 'Architecture'],
    ['stack', 'Technology'],
    ['repo', 'Repository map'],
    ['model', 'Data model'],
    ['scanner', 'The scanner'],
    ['promises', 'Promises, receipts and cards'],
    ['archive', 'Evidence archive'],
    ['automation', 'Schedule and deployment'],
    ['quality', 'Quality gates'],
    ['workflow', 'From lead to entry'],
    ['claude', 'How Claude was used'],
    ['maintenance', 'Keeping it current'],
    ['security', 'Security and privacy'],
    ['limits', 'Limits of automation'],
    ['run', 'Run it yourself'],
  ],
  id: [
    ['overview', 'Arsitektur'],
    ['stack', 'Teknologi'],
    ['repo', 'Peta repositori'],
    ['model', 'Model data'],
    ['scanner', 'Pemindai'],
    ['promises', 'Janji, bukti janji, dan kartu'],
    ['archive', 'Arsip bukti'],
    ['automation', 'Jadwal dan penerbitan'],
    ['quality', 'Gerbang mutu'],
    ['workflow', 'Dari petunjuk ke catatan'],
    ['claude', 'Cara Claude dipakai'],
    ['maintenance', 'Menjaga tetap mutakhir'],
    ['security', 'Keamanan dan privasi'],
    ['limits', 'Batas otomatisasi'],
    ['run', 'Menjalankan sendiri'],
  ],
}[lang];

const pipeline = {
  en: [
    ['Sources', `${sources.length} watched sources: ${newsSources} news searches and ${pageSources} official pages, covering ${countries}.`],
    ['Scanner', 'Twice a week, GitHub Actions runs npm run scan. It fetches, parses, scores and deduplicates.'],
    ['Triage', 'Optional. If an API key is set, Claude gives a second opinion on each new headline.'],
    ['Radar', 'New leads are written to data/radar.yml and appear on the Radar page, marked unreviewed.'],
    ['Archive', 'Every source without a preserved copy gets one in the Internet Archive, recorded next to the source.'],
    ['Author', 'The author opens the source, judges it, and either dismisses the lead or writes an entry.'],
    ['Gates', 'Every change passes the schemas, the validator, the tests and a full build.'],
    ['Outcomes', 'Each build computes every promise outcome as of that day and renders the receipts and their share cards.'],
    ['Site', 'A commit to main triggers a Vercel build. The static site updates within minutes.'],
  ],
  id: [
    ['Sumber', `${sources.length} sumber yang dipantau: ${newsSources} pencarian berita dan ${pageSources} halaman resmi, mencakup ${countries}.`],
    ['Pemindai', 'Dua kali seminggu, GitHub Actions menjalankan npm run scan. Pemindai mengambil, mengurai, menilai, dan menyaring duplikat.'],
    ['Triase', 'Opsional. Bila kunci API dipasang, Claude memberi pendapat kedua untuk setiap judul baru.'],
    ['Radar', 'Petunjuk baru ditulis ke data/radar.yml dan tampil di halaman Radar dengan tanda belum ditinjau.'],
    ['Arsip', 'Setiap sumber yang belum punya salinan disimpan di Internet Archive, dan salinannya dicatat di samping sumber itu.'],
    ['Penulis', 'Penulis membuka sumbernya, menilainya, lalu mengabaikan petunjuk itu atau menulis catatan.'],
    ['Gerbang', 'Setiap perubahan melewati skema, validator, pengujian, dan pembangunan situs penuh.'],
    ['Hasil', 'Setiap pembangunan menghitung hasil semua janji per hari itu dan membuat halaman bukti janji beserta kartu pratinjaunya.'],
    ['Situs', 'Commit ke main memicu pembangunan di Vercel. Situs statis diperbarui dalam hitungan menit.'],
  ],
}[lang];

const buildLog = getBuildLog();
const kindsUsed = BUILD_KINDS.filter((k) => buildLog.some((r) => r.kind === k));
const pr = (n: number) => `${SITE.repo}/pull/${n}`;
const kindLabel = {
  en: { feature: 'Feature', fix: 'Fix', content: 'Content', revert: 'Revert', rollback: 'Rollback' },
  id: { feature: 'Fitur', fix: 'Perbaikan', content: 'Konten', revert: 'Pembatalan', rollback: 'Pengembalian versi' },
}[lang];

const lede = {
  en: 'How Monsoon Ledger is built, how it collects and checks data, how it watches for new developments by itself, and how a lead becomes an entry. Everything described here is in the public repository.',
  id: 'Bagaimana Monsoon Ledger dibangun, bagaimana data dikumpulkan dan dicek, bagaimana situs ini memantau perkembangan baru dengan sendirinya, dan bagaimana sebuah petunjuk menjadi catatan. Semua yang dijelaskan di sini ada di repositori publik.',
}[lang];

const repoMap = `data/
  entries/*.yml        one file per entry (the ledger itself)
  instruments.yml      laws, drafts and guidance, with dossier fields
  deadlines.yml        public promises, newest first, in the promise format
  schema.json          JSON Schema for entries
  ontology.yml         institutions and curated, sourced links
  build-log.yml        every change asked for, shown below
  radar.yml            scanner output: unreviewed leads
  scan-log.yml         one row per scan
  watch/sources.yml    what the scanner reads
  watch/keywords.yml   how it scores
  watch/seen.json      ids already seen, so leads never return
docs/standard/v0.1/   the promise format: spec, JSON Schema, worked examples
kit/                   a starting point for a ledger in another country
scripts/
  validate.mjs         schemas and project rules, run before every build
  promises.mjs         deadline rules and computed outcomes, used everywhere
  archive.mjs          preserved copies of sources in the Internet Archive
  ontology.mjs         fuses all data into one graph of objects and links
  make-share-images.mjs  link preview cards and icons (resvg, fonts/)
  *.test.mjs           tests for promises, archive and ontology
  scan.mjs             the monitoring layer
  scan/parse.mjs       RSS, Atom and HTML link parsing
  scan/score.mjs       scoring, deduplication, dash rule
  scan/triage.mjs      optional Claude second opinion
  scan/scan.test.mjs   tests on synthetic fixtures
  new-entry.mjs        creates a dated entry from a template
  check-links.mjs      reports sources that stopped responding
site/                  Astro static site, no client framework
.github/workflows/
  ci.yml               tests, validation and build on every push
  scan.yml             the scheduled scan`;
---
<Base lang={lang} path="method/system/" title={lang === 'en' ? 'Technical system' : 'Sistem teknis'} nav="method" description={lede}>
  <header class="page-head">
    <p class="kicker">{lang === 'en' ? 'How the ledger works' : 'Cara catatan ini bekerja'}</p>
    <h1>{t.nav.method}</h1>
    <p class="lede">{lede}</p>
    <MethodTabs lang={lang} current="system" />
  </header>
  <div class="doc doc--rail">
    <nav class="toc" aria-label={t.onThisPage}>
      <p class="label">{t.onThisPage}</p>
      <ol>
        {toc.map(([id, label]) => <li><a href={`#${id}`}>{label}</a></li>)}
      </ol>
    </nav>
    <article class="doc-body">
      <h2 id="overview">1. {toc[0][1]}</h2>
      <ol class="pipeline">
        {pipeline.map(([name, text]) => <li><strong>{name}</strong><span>{text}</span></li>)}
      </ol>
      {
        lang === 'en' ? (
          <p>
            The design has one rule at its centre: automation may find things, but only the author may publish a claim. The scanner
            writes to the Radar and nowhere else, and the archiver only adds links to preserved copies beside sources. Entries,
            instruments and promises change only through a human edit that passes the same checks as every other change. Promise
            outcomes are never edited at all: they are computed.
          </p>
        ) : (
          <p>
            Desainnya berpusat pada satu aturan: otomatisasi boleh menemukan, tetapi hanya penulis yang boleh menerbitkan klaim. Pemindai
            hanya menulis ke Radar, dan pengarsip hanya menambahkan tautan salinan arsip di samping sumber. Catatan, instrumen, dan janji
            hanya berubah lewat suntingan manusia yang melewati pemeriksaan yang sama dengan perubahan lain. Hasil janji tidak pernah
            disunting sama sekali: hasilnya dihitung.
          </p>
        )
      }

      <h2 id="stack">2. {toc[1][1]}</h2>
      <div class="panel table-panel">
        <table class="ruled stack">
          <caption class="visually-hidden">{toc[1][1]}</caption>
          <thead>
            <tr>{cols.map((c) => <th scope="col">{c}</th>)}</tr>
          </thead>
          <tbody>
            <tr><td data-label={cols[0]}>Data</td><td data-label={cols[1]}>YAML files, JSON Schema 2020-12</td><td data-label={cols[2]}>{lang === 'en' ? 'Readable in a diff, editable by hand, versioned in git.' : 'Mudah dibaca di diff, bisa disunting manual, terekam di git.'}</td></tr>
            <tr><td data-label={cols[0]}>{lang === 'en' ? 'Validation' : 'Validasi'}</td><td data-label={cols[1]}>Ajv 8, js-yaml 4, Node.js</td><td data-label={cols[2]}>{lang === 'en' ? 'Entries and promises are checked against their published schemas. Rules a schema cannot express run in a script before every build.' : 'Catatan dan janji diperiksa dengan skema yang diterbitkan. Aturan yang tidak bisa dinyatakan skema dijalankan lewat skrip sebelum setiap build.'}</td></tr>
            <tr><td data-label={cols[0]}>{lang === 'en' ? 'Site' : 'Situs'}</td><td data-label={cols[1]}>Astro 7, static output</td><td data-label={cols[2]}>{lang === 'en' ? 'No server, no client framework, no tracking. Small scripts only for filters and the theme.' : 'Tanpa server, tanpa kerangka klien, tanpa pelacakan. Skrip kecil hanya untuk filter dan tema.'}</td></tr>
            <tr><td data-label={cols[0]}>{lang === 'en' ? 'Monitoring' : 'Pemantauan'}</td><td data-label={cols[1]}>Node.js scanner, GitHub Actions cron</td><td data-label={cols[2]}>{lang === 'en' ? 'Free, scheduled, logged, and every result is a reviewable commit.' : 'Gratis, terjadwal, tercatat, dan setiap hasilnya berupa commit yang bisa ditinjau.'}</td></tr>
            <tr><td data-label={cols[0]}>{lang === 'en' ? 'Triage' : 'Triase'}</td><td data-label={cols[1]}>Claude API through the official Anthropic SDK, structured JSON output</td><td data-label={cols[2]}>{lang === 'en' ? 'Optional second opinion on relevance. The scanner works without it.' : 'Pendapat kedua yang opsional tentang relevansi. Pemindai tetap bekerja tanpanya.'}</td></tr>
            <tr><td data-label={cols[0]}>{lang === 'en' ? 'Share cards' : 'Kartu pratinjau'}</td><td data-label={cols[1]}>resvg-js, Inter (SIL Open Font License)</td><td data-label={cols[2]}>{lang === 'en' ? 'Cards drawn as SVG and rendered to PNG during the build, so every card matches the data it was built from. The font is used for the images only, never loaded by the site.' : 'Kartu digambar sebagai SVG lalu dirender menjadi PNG saat pembangunan, jadi setiap kartu sesuai dengan data saat dibuat. Fonnya hanya dipakai untuk gambar, tidak pernah dimuat situs.'}</td></tr>
            <tr><td data-label={cols[0]}>{lang === 'en' ? 'Hosting' : 'Hosting'}</td><td data-label={cols[1]}>Vercel, Node 24</td><td data-label={cols[2]}>{lang === 'en' ? 'Builds every push to main and serves static files.' : 'Membangun setiap push ke main dan menyajikan berkas statis.'}</td></tr>
          </tbody>
        </table>
      </div>

      <h2 id="repo">3. {toc[2][1]}</h2>
      <pre class="code" tabindex="0"><code>{repoMap}</code></pre>

      <h2 id="model">4. {toc[3][1]}</h2>
      {
        lang === 'en' ? (
          <ul>
            <li><strong>Entry</strong> (<a href={file('data/schema.json')}>schema</a>): id, date, instrument, status, evidence level, titles and summaries in both languages, the seven Safety lens codes with a basis sentence in both languages and the day they were checked, last checked date, EU comparison, the author's take (optional, written only by the author), and at least one source with title, outlet, language and URL. An optional quote must be under 15 words.</li>
            <li><strong>Instrument</strong>: id, names, type, status, legal force, a source, and dossier fields: issuer, legal form, key points, EU counterpart, references, and whether the author has read it in full.</li>
            <li><strong>Promise</strong> (<a href={href(lang, 'method/standard/')}>format</a>, <a href={file('docs/standard/v0.1/promise.schema.json')}>schema</a>): date said, country, who said it and their role, the claim type, for dated promises a deadline rule, deadline and precision, the wording behind the deadline, the promise and what happened since in both languages, an optional outcome date with its source, the evidence level, and the source with its archived copy. There is no outcome field: the outcome is computed.</li>
            <li><strong>Analysis paper</strong> (<a href={file('scripts/analysis.mjs')}>rules</a>): Markdown with front matter (title, author, published and facts-as-of days, version, sources file, summary), numbered sources with access dates and archived copies, and marked quotes. Bahasa Indonesia texts may be partial draft translations.</li>
            <li><strong>Frontier incident</strong> (<a href={file('data/frontier-incidents.schema.json')}>schema</a>): developer, kind, the activity, awareness, notice and disclosure days as sources give them, who saw it first, the authority notified and the channel, countries, summaries in both languages and sources. Day counts are computed by <a href={file('scripts/frontier.mjs')}>scripts/frontier.mjs</a>.</li>
            <li><strong>Reading item</strong> (<a href={file('data/reading.schema.json')}>schema</a>): title, authors, year, kind, url, status (planned, reading, read), and for items read a finish date and the author's notes in both languages.</li>
            <li><strong>Lead</strong>: id (a hash of the normalised URL), date found, date published, headline, URL, outlet, country, language, source id, score, matched terms, an optional instrument hint, an optional Claude triage, and a review status: new, reviewed, promoted or dismissed.</li>
          </ul>
        ) : (
          <ul>
            <li><strong>Catatan</strong> (<a href={file('data/schema.json')}>skema</a>): id, tanggal, instrumen, status, tingkat bukti, judul dan ringkasan dalam dua bahasa, tujuh kode Lensa keselamatan beserta kalimat dasarnya dalam dua bahasa dan tanggal diperiksanya, tanggal terakhir dicek, perbandingan Uni Eropa, pendapat penulis (opsional, hanya ditulis penulis), dan paling sedikit satu sumber dengan judul, media, bahasa, dan URL. Kutipan opsional harus kurang dari 15 kata.</li>
            <li><strong>Instrumen</strong>: id, nama, jenis, status, kekuatan hukum, sumber, dan isian berkas: penerbit, bentuk hukum, pokok isi, padanan Uni Eropa, rujukan, dan apakah penulis sudah membacanya lengkap.</li>
            <li><strong>Janji</strong> (<a href={href(lang, 'method/standard/')}>format</a>, <a href={file('docs/standard/v0.1/promise.schema.json')}>skema</a>): tanggal diucapkan, negara, siapa yang mengucapkan dan jabatannya, jenis klaim, untuk janji bertenggat aturan tenggat, tenggat, dan ketepatannya, kalimat yang mendasari tenggat, janji dan apa yang terjadi sesudahnya dalam dua bahasa, tanggal hasil opsional beserta sumbernya, tingkat bukti, serta sumber beserta salinan arsipnya. Tidak ada kolom hasil: hasilnya dihitung.</li>
            <li><strong>Makalah analisis</strong> (<a href={file('scripts/analysis.mjs')}>aturan</a>): Markdown dengan front matter (judul, penulis, tanggal terbit dan tanggal fakta, versi, berkas sumber, ringkasan), sumber bernomor dengan tanggal akses dan salinan arsip, serta kutipan yang ditandai. Teks bahasa Indonesia boleh berupa terjemahan draf sebagian.</li>
            <li><strong>Insiden AI garda depan</strong> (<a href={file('data/frontier-incidents.schema.json')}>skema</a>): pengembang, jenis, tanggal aktivitas, saat diketahui, pemberitahuan, dan pengumuman sesuai sumber, siapa yang pertama melihat, otoritas yang diberi tahu dan jalurnya, negara, ringkasan dalam dua bahasa, dan sumber. Jumlah hari dihitung oleh <a href={file('scripts/frontier.mjs')}>scripts/frontier.mjs</a>.</li>
            <li><strong>Bacaan</strong> (<a href={file('data/reading.schema.json')}>skema</a>): judul, penulis, tahun, jenis, url, status (direncanakan, sedang dibaca, sudah dibaca), dan untuk yang sudah dibaca, tanggal selesai serta catatan penulis dalam dua bahasa.</li>
            <li><strong>Petunjuk</strong>: id (hash dari URL yang dinormalkan), tanggal ditemukan, tanggal terbit, judul, URL, media, negara, bahasa, id sumber, skor, kata yang cocok, petunjuk instrumen opsional, triase Claude opsional, dan status tinjauan: baru, sudah ditinjau, dijadikan catatan, atau diabaikan.</li>
          </ul>
        )
      }

      <h2 id="scanner">5. {toc[4][1]}</h2>
      {
        lang === 'en' ? (
          <>
            <p>The scanner (<a href={file('scripts/scan.mjs')}>scripts/scan.mjs</a>) runs these steps in order:</p>
            <ol>
              <li><strong>Read the source list.</strong> {sources.length} sources in <a href={file('data/watch/sources.yml')}>data/watch/sources.yml</a>. News searches use the Google News RSS endpoint in the right language edition, limited to the last 30 days. Official pages are read for their links.</li>
              <li><strong>Fetch.</strong> Each source is requested with a 25 second timeout and one retry, identifying itself as the Monsoon Ledger scanner. A failed source is logged and skipped. The run fails only if every source fails.</li>
              <li><strong>Parse.</strong> A small parser extracts headline, link, outlet, publication date and summary from RSS or Atom, or visible link text from HTML. It keeps only text and absolute http or https links, never markup or scripts.</li>
              <li><strong>Score.</strong> Each headline is matched against {keywords.terms.length} weighted terms in <a href={file('data/watch/keywords.yml')}>data/watch/keywords.yml</a>, in Bahasa Indonesia and English. The score is the sum of the weights of the distinct terms found. A lead is kept at a score of {keywords.threshold} or more, only if at least one core subject term (AI or data protection) is among them, so institution names alone never qualify, and unless one of {keywords.exclude.length} exclusion terms appears.</li>
              <li><strong>Deduplicate.</strong> URLs are normalised (host case, tracking parameters, fragments, trailing slashes) and hashed into a ten character id. A lead is skipped if its id was seen before, if the same headline arrived through another URL, or if the story is already a source in the ledger. Because news searches link through redirects, the ledger's own source URLs are also compared by their readable slug.</li>
              <li><strong>Hint and tag.</strong> Instrument hint terms suggest which instrument a lead may concern, linked on the Radar. The country tag comes from the headline, then the outlet name, and falls back to the source that found it, so a Malaysian story found by an Indonesian search is tagged Malaysia.</li>
              <li><strong>Triage, optional.</strong> With an ANTHROPIC_API_KEY secret set, up to 30 new leads go to Claude in one request. Claude sees only headline, outlet, date and country, and must answer in a fixed JSON schema: relevant or not, event type, instrument, a one sentence restatement of the headline, and confidence. Returned ids and instrument ids are checked against the input, summaries are capped at 30 words, and any error or refusal leaves the leads untriaged. On the site the summary is labelled as a machine summary of the headline.</li>
              <li><strong>Write.</strong> New leads are merged into data/radar.yml, newest first. Unreviewed leads are kept 180 days, reviewed ones a year, and the seen index 400 days so a pruned lead never comes back. Em and en dashes in headlines become hyphens, because the project bans them.</li>
            </ol>
            <p>The scanner is tested on synthetic fixtures (<a href={file('scripts/scan/scan.test.mjs')}>scan.test.mjs</a>): parsing, scoring, exclusion, deduplication, the dash rule, and that a second run adds nothing new.</p>
          </>
        ) : (
          <>
            <p>Pemindai (<a href={file('scripts/scan.mjs')}>scripts/scan.mjs</a>) menjalankan langkah-langkah ini secara berurutan:</p>
            <ol>
              <li><strong>Membaca daftar sumber.</strong> {sources.length} sumber di <a href={file('data/watch/sources.yml')}>data/watch/sources.yml</a>. Pencarian berita memakai RSS Google News dalam edisi bahasa yang sesuai, dibatasi 30 hari terakhir. Halaman resmi dibaca tautannya.</li>
              <li><strong>Mengambil.</strong> Setiap sumber diminta dengan batas waktu 25 detik dan satu kali percobaan ulang, dengan identitas pemindai Monsoon Ledger. Sumber yang gagal dicatat lalu dilewati. Pemindaian hanya dianggap gagal bila semua sumber gagal.</li>
              <li><strong>Mengurai.</strong> Pengurai kecil mengambil judul, tautan, media, tanggal terbit, dan ringkasan dari RSS atau Atom, atau teks tautan dari HTML. Yang disimpan hanya teks dan tautan http atau https absolut, tidak pernah markup atau skrip.</li>
              <li><strong>Menilai.</strong> Setiap judul dicocokkan dengan {keywords.terms.length} istilah berbobot di <a href={file('data/watch/keywords.yml')}>data/watch/keywords.yml</a>, dalam bahasa Indonesia dan Inggris. Skornya adalah jumlah bobot istilah berbeda yang ditemukan. Petunjuk disimpan bila skornya {keywords.threshold} atau lebih, hanya bila paling sedikit satu istilah inti (AI atau pelindungan data) ikut cocok, sehingga nama lembaga saja tidak pernah cukup, dan kecuali muncul salah satu dari {keywords.exclude.length} istilah pengecualian.</li>
              <li><strong>Menyaring duplikat.</strong> URL dinormalkan (huruf host, parameter pelacak, fragmen, garis miring di akhir) lalu di-hash menjadi id sepuluh karakter. Petunjuk dilewati bila id-nya pernah terlihat, bila judul yang sama datang lewat URL lain, atau bila beritanya sudah menjadi sumber di catatan. Karena pencarian berita memakai tautan pengalihan, URL sumber di catatan juga dibandingkan lewat slug yang bisa dibaca.</li>
              <li><strong>Petunjuk dan label.</strong> Istilah petunjuk menyarankan instrumen mana yang mungkin terkait, dan ditautkan di Radar. Label negara diambil dari judul, lalu nama media, dan bila tidak jelas memakai negara sumber yang menemukannya, sehingga berita Malaysia yang ditemukan lewat pencarian Indonesia tetap berlabel Malaysia.</li>
              <li><strong>Triase, opsional.</strong> Bila rahasia ANTHROPIC_API_KEY dipasang, sampai 30 petunjuk baru dikirim ke Claude dalam satu permintaan. Claude hanya melihat judul, media, tanggal, dan negara, dan wajib menjawab dalam skema JSON tetap: relevan atau tidak, jenis peristiwa, instrumen, satu kalimat yang mengulang judul, dan tingkat keyakinan. Id dan id instrumen yang dikembalikan dicocokkan dengan masukan, ringkasan dibatasi 30 kata, dan setiap galat atau penolakan membuat petunjuk tetap tanpa triase. Di situs, ringkasan itu diberi label ringkasan mesin dari judul.</li>
              <li><strong>Menulis.</strong> Petunjuk baru digabung ke data/radar.yml, terbaru di atas. Petunjuk yang belum ditinjau disimpan 180 hari, yang sudah ditinjau setahun, dan indeks yang pernah terlihat 400 hari supaya petunjuk yang sudah dibuang tidak kembali. Tanda pisah panjang di judul diganti tanda hubung, karena proyek ini melarangnya.</li>
            </ol>
            <p>Pemindai diuji dengan data contoh sintetis (<a href={file('scripts/scan/scan.test.mjs')}>scan.test.mjs</a>): penguraian, penilaian, pengecualian, penyaringan duplikat, aturan tanda pisah, dan bahwa pemindaian kedua tidak menambah apa pun.</p>
          </>
        )
      }

      <h2 id="promises">6. {toc[5][1]}</h2>
      {
        lang === 'en' ? (
          <ul>
            <li><strong>One outcome module.</strong> <a href={file('scripts/promises.mjs')}>scripts/promises.mjs</a> derives deadlines from their rules and computes each promise's outcome (met, missed, open or no deadline), its days past or left, and the headline counts. The validator, the ontology, every page, the RSS feeds and the share cards all call it, so a number cannot differ between two places. Outcomes are computed in Western Indonesian Time and never stored.</li>
            <li><strong>As of the build day.</strong> Every count states the day it was computed for. A small script in the page layout brings day counts on receipts up to the reader's day. If a deadline has passed since the build, the page keeps its build-day values, which agree with each other, until the next build, at least twice a week through the scan commit.</li>
            <li><strong>Receipts.</strong> Each promise has a permanent page at <code>/en/promises/&lt;key&gt;/</code> and <code>/id/promises/&lt;key&gt;/</code>, where the key is the date said and the speaker, the same key as its ontology object. It shows the wording in Bahasa Indonesia and English, the deadline and its basis, the computed outcome and day count, the evidence, the source and its archived copy, citations in plain text, APA and BibTeX with the data version (the short hash of the last commit that changed data/), and the entries and instruments it connects to.</li>
            <li><strong>Share cards.</strong> <a href={file('scripts/make-share-images.mjs')}>scripts/make-share-images.mjs</a> draws each card as SVG and renders it to PNG with resvg during the site build: one card per receipt per language, plus the site card. Each card shows its outcome, its day count and the day it was made. The same script regenerates the site icons. The full build takes seconds.</li>
            <li><strong>Feeds.</strong> The RSS feeds get an item when a promise changes outcome, dated the day after a missed deadline or the day a promise was kept.</li>
            <li><strong>Tests.</strong> <a href={file('scripts/promises.test.mjs')}>promises.test.mjs</a> covers leap years, month ends, months counted from the 31st, the deadline day itself, a promise kept on the deadline day, conditional and status claims, and the time zone.</li>
          </ul>
        ) : (
          <ul>
            <li><strong>Satu modul hasil.</strong> <a href={file('scripts/promises.mjs')}>scripts/promises.mjs</a> menurunkan tenggat dari aturannya dan menghitung hasil setiap janji (terpenuhi, terlewat, masih terbuka, atau tanpa tenggat), jumlah hari lewat atau tersisa, dan angka utama. Validator, ontologi, semua halaman, umpan RSS, dan kartu pratinjau memanggil modul ini, jadi angka tidak mungkin berbeda di dua tempat. Hasil dihitung menurut WIB dan tidak pernah disimpan.</li>
            <li><strong>Per hari pembangunan.</strong> Setiap angka menyebut hari penghitungannya. Skrip kecil di tata letak halaman memperbarui jumlah hari di halaman bukti janji ke hari pembaca. Jika sebuah tenggat lewat setelah pembangunan, halaman tetap memakai angka hari pembangunan, yang saling sesuai, sampai pembangunan berikutnya, paling sedikit dua kali seminggu lewat commit pemindaian.</li>
            <li><strong>Bukti janji.</strong> Setiap janji punya halaman tetap di <code>/en/promises/&lt;kunci&gt;/</code> dan <code>/id/promises/&lt;kunci&gt;/</code>, dengan kunci berupa tanggal diucapkan dan nama pembicara, sama dengan kunci objeknya di ontologi. Halaman itu menampilkan kata-kata dalam bahasa Indonesia dan Inggris, tenggat dan dasarnya, hasil yang dihitung dan jumlah harinya, bukti, sumber dan salinan arsipnya, kutipan dalam teks biasa, APA, dan BibTeX beserta versi datanya (hash pendek commit terakhir yang mengubah data/), serta catatan dan instrumen yang terhubung.</li>
            <li><strong>Kartu pratinjau.</strong> <a href={file('scripts/make-share-images.mjs')}>scripts/make-share-images.mjs</a> menggambar setiap kartu sebagai SVG lalu merendernya menjadi PNG dengan resvg saat situs dibangun: satu kartu per bukti janji per bahasa, ditambah kartu situs. Setiap kartu menampilkan hasil, jumlah hari, dan hari kartu dibuat. Skrip yang sama membuat ulang ikon situs. Seluruh pembangunan hanya butuh beberapa detik.</li>
            <li><strong>Umpan RSS.</strong> Umpan RSS mendapat satu item ketika hasil sebuah janji berubah, bertanggal sehari setelah tenggat yang terlewat atau hari janji ditepati.</li>
            <li><strong>Pengujian.</strong> <a href={file('scripts/promises.test.mjs')}>promises.test.mjs</a> menguji tahun kabisat, akhir bulan, bulan yang dihitung dari tanggal 31, hari tenggat itu sendiri, janji yang ditepati tepat pada hari tenggat, janji bersyarat dan klaim kemajuan, serta zona waktu.</li>
          </ul>
        )
      }

      <h2 id="archive">7. {toc[6][1]}</h2>
      {
        lang === 'en' ? (
          <ul>
            <li><strong>What.</strong> <a href={file('scripts/archive.mjs')}>scripts/archive.mjs</a> (<code>npm run archive</code>) gives every source url in the promises, the instruments, the entries, the analysis sources and the frontier incident reference a preserved copy in the Internet Archive.</li>
            <li><strong>How.</strong> It asks the Wayback Machine availability API for an existing snapshot first. If there is none, it requests one through Save Page Now, at most eight per run with a twelve second pause between requests.</li>
            <li><strong>Where it writes.</strong> Only <code>archive_url</code> and <code>archived_at</code>, beside each source, by editing lines so comments and folded text stay exactly as they were. It never changes any other field.</li>
            <li><strong>When.</strong> After every scheduled scan. It may fail without stopping the scan or the build; failures are logged in the workflow, and the validator warns about every source still without a copy.</li>
            <li><strong>Tests.</strong> <a href={file('scripts/archive.test.mjs')}>archive.test.mjs</a> mocks the network and checks snapshot lookup, saving, rate limiting, failure handling, dry runs and that the file edits touch nothing else.</li>
          </ul>
        ) : (
          <ul>
            <li><strong>Apa.</strong> <a href={file('scripts/archive.mjs')}>scripts/archive.mjs</a> (<code>npm run archive</code>) menyimpan salinan setiap url sumber janji, instrumen, catatan, makalah analisis, dan rujukan insiden AI garda depan di Internet Archive.</li>
            <li><strong>Caranya.</strong> Skrip ini lebih dulu menanyakan salinan yang sudah ada ke API ketersediaan Wayback Machine. Jika tidak ada, skrip meminta salinan baru lewat Save Page Now, paling banyak delapan per pemindaian dengan jeda dua belas detik di antaranya.</li>
            <li><strong>Apa yang ditulis.</strong> Hanya <code>archive_url</code> dan <code>archived_at</code>, di samping setiap sumber, dengan menyunting baris sehingga komentar dan teks lipat tetap persis seperti semula. Kolom lain tidak pernah diubah.</li>
            <li><strong>Kapan.</strong> Setelah setiap pemindaian terjadwal. Skrip ini boleh gagal tanpa menghentikan pemindaian atau pembangunan; kegagalannya tercatat di alur kerja, dan validator memberi peringatan untuk setiap sumber yang belum punya salinan.</li>
            <li><strong>Pengujian.</strong> <a href={file('scripts/archive.test.mjs')}>archive.test.mjs</a> memalsukan jaringan dan memeriksa pencarian salinan, penyimpanan, pembatasan laju, penanganan kegagalan, uji coba tanpa menulis, dan bahwa suntingan berkas tidak menyentuh hal lain.</li>
          </ul>
        )
      }

      <h2 id="automation">8. {toc[7][1]}</h2>
      {
        lang === 'en' ? (
          <ul>
            <li><strong>When.</strong> Every Monday and Thursday at 06:17 Western Indonesian Time (cron <code>17 23 * * 0,3</code> in UTC), so fresh leads are waiting at the start of the working day in Jakarta. Twice a week matches how often Indonesian AI policy news actually moves, without flooding the Radar.</li>
              <li><strong>What runs.</strong> The <a href={file('.github/workflows/scan.yml')}>scan workflow</a> installs dependencies, runs the tests, runs the scan, archives sources, validates the data and builds the site. Only if the validation and the build pass does it commit radar.yml, scan-log.yml, seen.json and any new archive links to main.</li>
            <li><strong>Publishing.</strong> The commit triggers Vercel, which builds and serves the new static site. No server is involved at any point.</li>
            <li><strong>On pull requests.</strong> Changes to the scanner run it as a dry run against the live sources, without Claude and without committing, so a change is tested on real feeds before it is merged.</li>
            <li><strong>On demand.</strong> The workflow can also be started by hand from the GitHub Actions tab.</li>
          </ul>
        ) : (
          <ul>
            <li><strong>Kapan.</strong> Setiap Senin dan Kamis pukul 06.17 WIB (cron <code>17 23 * * 0,3</code> dalam UTC), supaya petunjuk baru sudah menunggu di awal hari kerja di Jakarta. Dua kali seminggu sesuai dengan seberapa sering berita kebijakan AI Indonesia benar-benar bergerak, tanpa membanjiri Radar.</li>
            <li><strong>Apa yang dijalankan.</strong> <a href={file('.github/workflows/scan.yml')}>Alur kerja pemindaian</a> memasang dependensi, menjalankan pengujian, menjalankan pemindaian, mengarsipkan sumber, memvalidasi data, dan membangun situs. Hanya bila validasi dan pembangunan lolos, alur kerja meng-commit radar.yml, scan-log.yml, seen.json, dan tautan arsip baru ke main.</li>
            <li><strong>Penerbitan.</strong> Commit itu memicu Vercel, yang membangun dan menyajikan situs statis yang baru. Tidak ada server yang terlibat.</li>
            <li><strong>Pada pull request.</strong> Perubahan pada pemindai menjalankannya sebagai uji coba terhadap sumber asli, tanpa Claude dan tanpa commit, supaya perubahan diuji pada umpan nyata sebelum digabung.</li>
            <li><strong>Sesuai permintaan.</strong> Alur kerja ini juga bisa dijalankan manual dari tab GitHub Actions.</li>
          </ul>
        )
      }

      <h2 id="quality">9. {toc[8][1]}</h2>
      {
        lang === 'en' ? (
          <p>
            Every push, by the author or by the scanner, passes four gates in <a href={file('.github/workflows/ci.yml')}>CI</a>: the tests (scanner,
            promises, ontology, archive, analysis papers, quote check, safety lens, frontier incidents, reading list and language parity),
            the validator, the JSON Schemas and a full site build, which ends with a parity check: every page must exist in English and
            Bahasa Indonesia unless it is marked partial. The validator also checks the analysis papers (every citation, every source,
            https only, no duplicate urls, quote length and one quote per source), the results of the quote check, the safety lens
            rules, the frontier incident reference and the reading list. <code>npm run links</code> checks every internal link and anchor
            in the built site. The validator checks entries,
            instruments, promises, the watched sources and every Radar lead. Promises are checked against the published promise schema,
            and every deadline is recomputed from its rule. The worked examples in the format's documentation are checked the same way.
            Sources without an archived copy are reported as warnings, never as failures. Any em or en dash anywhere in the project is
            rejected. With <code>npm run validate -- --data &lt;folder&gt;</code> the same validator checks only a promise ledger's data folder,
            such as the kit. The checks applied to entries are listed on the <a href={href(lang, 'method/#data')}>Research protocol</a> page.
          </p>
        ) : (
          <p>
            Setiap push, oleh penulis maupun pemindai, melewati empat gerbang di <a href={file('.github/workflows/ci.yml')}>CI</a>: pengujian (pemindai,
            janji, ontologi, arsip, makalah analisis, pemeriksaan kutipan, lensa keselamatan, insiden AI garda depan, daftar bacaan, dan
            kesetaraan bahasa), validator, JSON Schema, dan pembangunan situs penuh yang diakhiri pemeriksaan kesetaraan: setiap halaman
            harus ada dalam bahasa Inggris dan Indonesia kecuali ditandai sebagian. Validator juga memeriksa makalah analisis (setiap
            rujukan, setiap sumber, hanya https, tanpa url ganda, panjang kutipan, dan satu kutipan per sumber), hasil pemeriksaan kutipan,
            aturan lensa keselamatan, rujukan insiden AI garda depan, dan daftar bacaan. <code>npm run links</code> memeriksa setiap tautan
            dan jangkar internal di situs yang sudah dibangun. Validator memeriksa catatan, instrumen, janji,
            sumber yang dipantau, dan setiap petunjuk Radar. Janji diperiksa dengan skema janji yang diterbitkan, dan setiap tenggat
            dihitung ulang dari aturannya. Contoh di dokumentasi format diperiksa dengan cara yang sama. Sumber tanpa salinan arsip
            dilaporkan sebagai peringatan, bukan kegagalan. Tanda pisah panjang di mana pun di proyek ini ditolak. Dengan{' '}
            <code>npm run validate -- --data &lt;folder&gt;</code> validator yang sama hanya memeriksa folder data sebuah catatan janji, misalnya
